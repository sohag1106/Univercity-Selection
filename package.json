{
  "name": "sommersemester-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Static tracker app + phone/PIN login and cloud sync (Neon). DATABASE_URL lives in gitignored .env.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cf:build": "node cf-build.js",
    "cf:dev": "node cf-build.js && wrangler dev --port 8787 --ip 127.0.0.1",
    "cf:deploy": "node cf-build.js && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "wrangler": "^4.146.0"
  }
}
